---
# Swift API notes for Darling's Foundation (private Swift-overlay build SDK).
# SwiftBridge tells the Clang importer which Swift value types the Objective-C classes bridge to, so
# APIs taking or returning them import with the Swift types (NSString * -> String).
Name: Foundation
Classes:
- Name: NSString
  SwiftBridge: Swift.String
- Name: NSArray
  SwiftBridge: Swift.Array
- Name: NSDictionary
  SwiftBridge: Swift.Dictionary
- Name: NSSet
  SwiftBridge: Swift.Set
Typedefs:
# Like the macOS SDK (NS_TYPED_EXTENSIBLE_ENUM): NSURLResourceKey imports as the struct URLResourceKey, which Swift
# mangles as `So16NSURLResourceKeya`.
- Name: NSURLResourceKey
  SwiftWrapper: struct
  SwiftName: URLResourceKey
