---
# Swift API notes for Darling's Foundation (private Swift-overlay build SDK).
# SwiftBridge tells the Clang importer which Swift value types the Objective-C classes bridge to, so
# APIs taking or returning them import with the Swift types (NSString * -> String).
Name: Foundation
Classes:
- Name: NSString
  SwiftBridge: Swift.String
- Name: NSArray
  SwiftBridge: Swift.Array
- Name: NSDictionary
  SwiftBridge: Swift.Dictionary
- Name: NSSet
  SwiftBridge: Swift.Set
# SwiftName renames an Objective-C class to the name Swift code written against a recent macOS SDK
# spells it. The class is unchanged; only the Swift-facing name is added. Without these the Swift
# spelling does not resolve at all, and the diagnostic ("cannot find type 'RunLoop' in scope")
# points at the caller rather than at the missing rename.
- Name: NSRunLoop
  SwiftName: RunLoop
- Name: NSUserDefaults
  SwiftName: UserDefaults
- Name: NSThread
  SwiftName: Thread
- Name: NSScanner
  SwiftName: Scanner
- Name: NSURLSession
  SwiftName: URLSession
- Name: NSFileManager
  SwiftName: FileManager
- Name: NSProcessInfo
  SwiftName: ProcessInfo
- Name: NSTimer
  SwiftName: Timer
- Name: NSFormatter
  SwiftName: Formatter
- Name: NSNumberFormatter
  SwiftName: NumberFormatter
- Name: NSDateComponentsFormatter
  SwiftName: DateComponentsFormatter
- Name: NSISO8601DateFormatter
  SwiftName: ISO8601DateFormatter
- Name: NSMeasurementFormatter
  SwiftName: MeasurementFormatter
- Name: NSJSONSerialization
  SwiftName: JSONSerialization
Typedefs:
# Like the macOS SDK (NS_TYPED_EXTENSIBLE_ENUM): NSURLResourceKey imports as the struct URLResourceKey, which Swift
# mangles as `So16NSURLResourceKeya`.
- Name: NSURLResourceKey
  SwiftWrapper: struct
  SwiftName: URLResourceKey
# The importer does not infer nesting from NS_TYPED_EXTENSIBLE_ENUM or NS_ENUM, so without the
# four entries below the macOS spellings NSAttributedString.Key, NSCalendar.Unit,
# NumberFormatter.Style and RunLoop.Mode do not resolve at all.
- Name: NSAttributedStringKey
  SwiftName: NSAttributedString.Key
- Name: NSRunLoopMode
  SwiftName: RunLoop.Mode
Tags:
- Name: NSCalendarUnit
  SwiftName: NSCalendar.Unit
- Name: NSNumberFormatterStyle
  SwiftName: NumberFormatter.Style
Enumerators:
# Nesting an enum does not re-derive its cases: the importer strips the common NSNumberFormatter
# prefix but not the trailing Style, leaving .decimalStyle rather than macOS's .decimal.
- Name: NSNumberFormatterNoStyle
  SwiftName: none
- Name: NSNumberFormatterDecimalStyle
  SwiftName: decimal
- Name: NSNumberFormatterCurrencyStyle
  SwiftName: currency
- Name: NSNumberFormatterPercentStyle
  SwiftName: percent
- Name: NSNumberFormatterScientificStyle
  SwiftName: scientific
- Name: NSNumberFormatterSpellOutStyle
  SwiftName: spellOut
Globals:
- Name: NSDefaultRunLoopMode
  SwiftName: RunLoop.Mode.default
- Name: NSRunLoopCommonModes
  SwiftName: RunLoop.Mode.common
